---
// src/components/StravaDashboard.astro
import stravaData from '../data/strava-activities.json';

interface Activity {
  date: string; // YYYY-MM-DD
  distanceKm: number;
}

const TOTAL_GOAL_KM = 40075;

// Compute metrics
const activities: Activity[] = stravaData || [];
const totalDistanceKm = activities.reduce((sum, act) => sum + act.distanceKm, 0);
const progressPercentage = ((totalDistanceKm / TOTAL_GOAL_KM) * 100).toFixed(2);
const totalRuns = activities.length;

// Generate last 365 days for the GitHub-like heat map grid
const today = new Date();
const pastYearDays = Array.from({ length: 365 }).map((_, i) => {
  const d = new Date();
  d.setDate(today.getDate() - (364 - i));
  const dateStr = d.toISOString().split('T')[0];
  const matchedRun = activities.find(a => a.date === dateStr);
  return {
    date: dateStr,
    distanceKm: matchedRun ? matchedRun.distanceKm : 0,
  };
});

// Color density function (GitHub-style intensity levels)
function getHeatmapColor(km: number) {
  if (km === 0) return 'bg-zinc-800/50 border-zinc-700/30';
  if (km < 5) return 'bg-orange-950 border-orange-800 text-orange-400';
  if (km < 10) return 'bg-orange-700 border-orange-600 text-white';
  if (km < 21.1) return 'bg-orange-500 border-orange-400 text-white font-bold';
  return 'bg-amber-400 border-amber-300 text-zinc-950 font-extrabold'; // Half marathon or more
}
---

<div class="space-y-8 my-8 p-6 bg-zinc-900/60 border border-zinc-800 rounded-2xl shadow-xl">
  
  <div class="space-y-3">
    <div class="flex justify-between items-end">
      <div>
        <span class="font-mono text-xs uppercase tracking-wider text-orange-400 block mb-1">Global Target</span>
        <h3 class="text-2xl font-bold font-mono text-zinc-100">
          {totalDistanceKm.toFixed(1)} <span class="text-sm font-normal text-zinc-400">/ {TOTAL_GOAL_KM.toLocaleString()} km</span>
        </h3>
      </div>
      <div class="text-right">
        <span class="text-xs font-mono text-zinc-400">Circumference Covered</span>
        <div class="text-xl font-mono font-bold text-orange-400">{progressPercentage}%</div>
      </div>
    </div>

    <div class="w-full h-3 bg-zinc-950 rounded-full overflow-hidden border border-zinc-800">
      <div 
        class="h-full bg-gradient-to-r from-orange-600 to-amber-400 rounded-full transition-all duration-1000"
        style={`width: ${Math.max(Number(progressPercentage), 1)}%`}
      ></div>
    </div>
  </div>

  <div class="grid grid-cols-2 md:grid-cols-3 gap-4 font-mono text-xs">
    <div class="p-3 bg-zinc-950/80 rounded-lg border border-zinc-800">
      <span class="text-zinc-500 block">Total Running Sessions</span>
      <span class="text-lg font-bold text-zinc-100">{totalRuns} Runs</span>
    </div>
    <div class="p-3 bg-zinc-950/80 rounded-lg border border-zinc-800">
      <span class="text-zinc-500 block">Remaining Distance</span>
      <span class="text-lg font-bold text-zinc-100">{(TOTAL_GOAL_KM - totalDistanceKm).toFixed(0)} km</span>
    </div>
    <div class="p-3 bg-zinc-950/80 rounded-lg border border-zinc-800 col-span-2 md:col-span-1">
      <span class="text-zinc-500 block">Furthest Single Run</span>
      <span class="text-lg font-bold text-orange-400">21.1 km (Half Marathon)</span>
    </div>
  </div>

  <div>
    <div class="flex justify-between items-center mb-3">
      <h4 class="font-mono text-xs uppercase tracking-wider text-zinc-400">
        365-Day Activity Heatmap
      </h4>
      <div class="flex items-center gap-1.5 font-mono text-[10px] text-zinc-500">
        <span>Less</span>
        <span class="w-2.5 h-2.5 rounded-sm bg-zinc-800/80 border border-zinc-700/50"></span>
        <span class="w-2.5 h-2.5 rounded-sm bg-orange-950 border border-orange-800"></span>
        <span class="w-2.5 h-2.5 rounded-sm bg-orange-700 border border-orange-600"></span>
        <span class="w-2.5 h-2.5 rounded-sm bg-orange-500 border border-orange-400"></span>
        <span class="w-2.5 h-2.5 rounded-sm bg-amber-400 border border-amber-300"></span>
        <span>More</span>
      </div>
    </div>

    <div class="overflow-x-auto pb-2">
      <div class="grid grid-rows-7 grid-flow-col gap-1.5 w-max">
        {pastYearDays.map((day) => (
          <div 
            title={`${day.date}: ${day.distanceKm > 0 ? `${day.distanceKm.toFixed(2)} km` : 'No run'}`}
            class={`w-3.5 h-3.5 rounded-sm border transition-transform hover:scale-125 cursor-pointer ${getHeatmapColor(day.distanceKm)}`}
          ></div>
        ))}
      </div>
    </div>
  </div>

</div>