---
// src/components/Header.astro
import ModeToggle from './ModeToggle.astro';
import LanguagePicker from './LanguagePicker.astro';
import { useTranslations } from '../i18n/ui';
import type { ui } from '../i18n/ui';

// Astro automatically detects the language from the current URL route!
const lang = (Astro.currentLocale ?? 'en') as keyof typeof ui;
const t = useTranslations(lang);
---

<header class="sticky top-0 z-50 backdrop-blur-md bg-zinc-950/80 border-b border-zinc-800/80">
  <div class="max-w-5xl mx-auto px-6 h-16 flex items-center justify-between">
    <!-- Left: Brand & Nav Links -->
    <div class="flex items-center gap-8">
      <a href="/" class="font-mono font-bold text-zinc-100 tracking-wider">
        FAS
      </a>
      <nav class="flex gap-4">
        <!-- <a href="#projects" class="text-sm text-zinc-400 hover:text-zinc-100 transition-colors">
          {t('nav.projects')}
        </a> -->
      </nav>
    </div>

    <!-- Right Controls: Grouped together with fixed spacing -->
    <div class="flex items-center gap-3 shrink-0">
      <LanguagePicker />
      <ModeToggle />
    </div>
  </div>
</header>