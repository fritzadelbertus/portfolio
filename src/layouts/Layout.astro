---
// src/layouts/Layout.astro
import '../styles/global.css';
interface Props {
  title: string;
  category?: string; // Optional project category passed from project detail page
}
import Header from '../components/Header.astro';

const { title, category } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>{title}</title>

    <script is:inline define:vars={{ category }}>
      (function () {
        const savedTheme = localStorage.getItem('theme-mode');
        const isCreativeCategory = category === 'Others'; // Add more categories if needed

        // Auto-enable Creative Mode if category is 'Others' or if user saved 'creative' in localStorage
        if (savedTheme === 'creative' || (savedTheme === null && isCreativeCategory)) {
          document.documentElement.classList.add('creative-mode');
        } else if (savedTheme === 'professional') {
          document.documentElement.classList.remove('creative-mode');
        }
      })();
    </script>
  </head>
  <body>
    <Header />
    <slot />
  </body>
</html>