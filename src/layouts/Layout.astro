---
// src/layouts/Layout.astro
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const { 
  title = "Fritz Adelbertus Sitindaon | Portfolio", 
  description = "Mathematician & Software Engineer specializing in quantitative systems, applied cryptography, and systems automation." 
} = Astro.props;
---

<!usr/bin/env html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>

    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/katex@0.16.8/dist/katex.min.css"
      integrity="sha384-GvrOXuhHUM816WXAnB8CH6TW0Tvp08o68ijy42iA6OXpht5JVJgR7e8A+1b92X4y"
      crossorigin="anonymous"
    />
  </head>
  <body class="bg-zinc-950 text-zinc-100 font-sans min-h-screen antialiased selection:bg-cyan-500/30 selection:text-cyan-200 transition-colors duration-500">
    
    <div class="min-h-screen flex flex-col justify-between">
      
      <main class="flex-grow">
        <slot />
      </main>

      <footer class="border-t border-zinc-800/80 py-8 text-center font-mono text-xs text-zinc-500">
        <p>© {new Date().getFullYear()} Fritz Adelbertus Sitindaon. Built with Astro & Tailwind CSS.</p>
      </footer>

    </div>

  </body>
</html>