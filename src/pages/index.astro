---
// src/pages/index.astro
import '../styles/global.css';
import Hero from '../components/Hero.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ModeToggle from '../components/ModeToggle.astro';
import { getCollection } from 'astro:content';

// Fetch all markdown files managed by src/content.config.ts
const allProjects = await getCollection('projects');

// Filter projects based on the category defined in frontmatter
const proProjects = allProjects.filter(p => 
  ['Quant', 'Systems', 'Mathematics', 'Data'].includes(p.data.category)
);

const creativeProjects = allProjects.filter(p => 
  ['Game Dev', 'Web', 'Others'].includes(p.data.category)
);
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.8/dist/katex.min.css" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>Fritz Adelbertus Sitindaon | Portfolio</title>
  </head>
  <body class="bg-zinc-950 text-zinc-100 min-h-screen transition-colors duration-500">

    <header class="sticky top-0 z-50 backdrop-blur-md bg-zinc-950/80 border-b border-zinc-800/80">
      <div class="max-w-5xl mx-auto px-6 h-16 flex items-center justify-between">
        <a href="/" class="font-mono font-bold text-zinc-100 tracking-wider">
          FAS
        </a>
        
        <ModeToggle />
      </div>
    </header>

    <div class="max-w-5xl mx-auto px-6 space-y-16 relative">
      
      <div class="relative overflow-hidden rounded-2xl mb-12">
        <div 
          id="hero-bg-creative" 
          class="absolute inset-0 z-0 bg-cover bg-center opacity-0 transition-opacity duration-700 pointer-events-none"
          style="background-image: url('/assets/images/hero_image.webp');"
        >
          <div class="absolute inset-0 bg-zinc-950/0 backdrop-brightness-75"></div>
        </div>

        <div class="relative z-10 p-6 md:p-10">
          <Hero />
        </div>
      </div>

      <section id="projects" class="py-8">
        <h2 class="project-pro text-2xl font-bold tracking-tight mb-8 text-zinc-100">
          Featured Work
        </h2>
        <h2 class="project-creative text-2xl font-bold tracking-tight mb-8 text-zinc-100">
          Creative Work
        </h2>

        <div class="project-pro grid grid-cols-1 md:grid-cols-2 gap-6">
          {proProjects.map((project) => (
            <ProjectCard 
              title={project.data.title}
              description={project.data.description}
              tags={project.data.tags}
              metrics={project.data.metrics}
              slug={project.id}
            />
          ))}
        </div>

        <div class="project-creative hidden grid grid-cols-1 md:grid-cols-2 gap-6">
          {creativeProjects.map((project) => (
            <ProjectCard 
              title={project.data.title}
              description={project.data.description}
              tags={project.data.tags}
              metrics={project.data.metrics}
              slug={project.id}
            />
          ))}
        </div>
      </section>

    </div>
  </body>
</html>